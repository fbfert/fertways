<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!-- Amarra o seed às tabelas do GDD. É o que torna a regra de ouro mecânica. -->
        <testsuite name="Gdd">
            <directory>tests/Gdd</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!--
            Fixo, porque em produção o `.env` traz `APP_URL=https://fertways.tars.art.br/central`:
            a aplicação é montada sob um subcaminho. As chamadas de teste (`$this->get('/')`)
            derivam a URL daqui, e um APP_URL com caminho faria todas baterem em `/central/...`,
            que não é rota — 28 testes viravam 404 sem nenhuma mudança de código.
        -->
        <env name="APP_URL" value="http://localhost"/>

        <!--
            Este repositório é implantado na mesma máquina em que se roda a suíte, e lá existe
            um `bootstrap/cache/config.php` gerado por `php artisan config:cache`. Um config em
            cache é lido ANTES do .env e ignora todo o `<env>` acima: os testes passavam a ver
            `database.default=mysql` e `app.env=production`, ou seja, `RefreshDatabase` mirando
            o banco de produção. O que impediu o estrago foi o `migrate:fresh` se recusar a
            rodar sob `APP_ENV=production` sem a flag de força — sorte, não projeto.

            Apontar as caches para um caminho inexistente faz `configurationIsCached()` devolver
            false e a configuração ser lida dos arquivos, com o `<env>` valendo. Vale em qualquer
            máquina; num CI limpo, onde não há cache, não muda nada.
        -->
        <env name="APP_CONFIG_CACHE" value="bootstrap/cache/nao-existe-config.php"/>
        <env name="APP_ROUTES_CACHE" value="bootstrap/cache/nao-existe-routes.php"/>
        <env name="APP_EVENTS_CACHE" value="bootstrap/cache/nao-existe-events.php"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
